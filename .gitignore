# ── 运行时环境（各 ~8 GB，不进仓库）──────────────────────────────
runtime/

# ── 权重与缓存 ────────────────────────────────────────────────
weights/*
!weights/manifest.json
*.onnx
!app/modelhub/__init__.py
**/_engines/
*_xseglite*.engine

# ── 用户数据 ─────────────────────────────────────────────────
workspace/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.venv/
venv/

# ── 构建产物 ─────────────────────────────────────────────────
dist/
build/
node_modules/
.idea/
*.iml


# ── 杂项 ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
_shots/
_trash/

# 权重/模型二进制一律不入库（GitHub 单文件上限 100MB）
*.pth
*.pt
*.npy
*.dat
*.onnx.data
app/modelhub/onnx/
app/xlib/models/
lab/**/*.npy
# 调试残留（截图 / Electron 临时 profile / 抓包脚本）
_electron_tmp*/
_ref/
_serve*.log
*.tmp
# 子任务/调试留下的临时产物（不命名为 _xxx.log 也要挡）
_*.log
_probe_*.py
_splice.py
bg_*.png
f_*.png

# 登录凭证 / 用户信息：只留本机，不进仓库
app/docs/legacy-reference/qt-ui/user/bilibili_cookie.txt
app/docs/legacy-reference/qt-ui/user/user_info.json
app/docs/legacy-reference/qt-ui/user/*.bak
# 归档后 4.0 界面那份登录凭证的落点（**/ 通配已覆盖，这两行是显式说明）

# GPU 实验目录：本地约 2 GB 的权重/引擎，纯实验，不进仓库
app/DFL_GPU_LAB/

# 预览原型的假数据截图（mock_dfl_preview.py 生成）
docs/preview/**/mock_preview_shot*.png

# 权重与代码分离：weights/ 只放模型二进制，manifest.json 入库
weights/**/*.onnx
weights/**/*.pth
weights/**/*.pt
weights/**/*.engine
!weights/manifest.json

# 登录凭据：任何位置的 cookie / 用户信息都不入库
**/bilibili_cookie.txt
**/bilibili_cookie.txt.bak
**/user_info.json
app/engine/ui/user/

# 根目录调试残留（截图 / 日志 / 临时脚本）
/_*.log
/_*.png
/_*.txt
/_*.json

# B վ WBI ǩ������
.wbi_cache.json
**/.wbi_cache.json

# ── 台架/探针产物（只在本地，不进仓）────────────────────────────
# 只挡仓库根的那两个 scratch 目录；写成 _enc4k_bench/ 这种无前导斜杠的模式会连
# app/docs/notes/experiments/ 一起吞掉（gitignore 的目录模式在任意深度都匹配）。
/_enc4k_bench/
/experiments/
app/engine/assets/screenshots/
app/engine/ui/
app/engine/MergeStudio/workspace/
