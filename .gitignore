# ── 运行时环境（各 ~8 GB，不进仓库）──────────────────────────────
runtime/

# ── 权重与缓存 ────────────────────────────────────────────────
weights/
*.onnx
!app/modelhub/__init__.py
**/_engines/
*_xseglite*.engine

# ── 用户数据 ─────────────────────────────────────────────────
workspace/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.venv/
venv/

# ── 构建产物 ─────────────────────────────────────────────────
dist/
build/
node_modules/

# ── 杂项 ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
_shots/
_trash/

# 权重/模型二进制一律不入库（GitHub 单文件上限 100MB）
*.pth
*.pt
*.npy
*.dat
*.onnx.data
app/modelhub/onnx/
app/xlib/models/
app/DFL_GPU_LAB/**/*.npy
